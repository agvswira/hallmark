{
  "name": "@hallmark/verifier",
  "version": "0.1.1",
  "description": "Hallmark verification engine: recompile Solidity sources and match them against QoreChain bytecode, with a PQC precompile report.",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:live": "tsx scripts/verify-live.ts",
    "record:self": "tsx scripts/record-self.ts",
    "transfer-ownership": "tsx scripts/transfer-ownership.ts",
    "window": "tsx scripts/window-ops.ts",
    "build": "node build.mjs",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@ethereum-sourcify/lib-sourcify": "^3.8.1",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0",
    "solc": "^0.8.39",
    "viem": "^2.58.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "private": true,
  "optionalDependencies": {
    "@foundry-rs/anvil-darwin-arm64": "1.7.1",
    "@foundry-rs/anvil-linux-amd64": "1.7.1",
    "@foundry-rs/anvil-win32-amd64": "1.7.1"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./abi": {
      "types": "./dist/registryAbi.d.ts",
      "default": "./dist/registryAbi.js"
    }
  },
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ]
}
