{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/verify.ts": { "maxDuration": 120, "memory": 2048 }
  },
  "rewrites": [
    { "source": "/lcd-testnet/:path*", "destination": "https://api-testnet.qore.host/:path*" },
    { "source": "/((?!api/|lcd-testnet/|assets/).*)", "destination": "/index.html" }
  ]
}
