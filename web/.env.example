# Only needed if you add a WalletConnect-based wallet to src/wagmi.ts.
# QoreX and injected browser wallets do not use it.
VITE_WALLETCONNECT_PROJECT_ID=

# Server-side (API routes). Never commit real values.
# Testnet verifier account (BIP-39 mnemonic): the account allowed to write HallmarkRegistry.
# It also holds the account's ML-DSA-87 key, used to open its registry-scoped EVM window.
HALLMARK_VERIFIER_MNEMONIC=
# Public URL of this deployment, used in on-chain records (e.g. https://hallmark.example).
HALLMARK_PUBLIC_URL=
# Optional: another EVM RPC for qorechain-diana.
HALLMARK_RPC_URL=
# Set by Vercel when a Blob store is connected; without it sources are kept in web/.data.
BLOB_READ_WRITE_TOKEN=
