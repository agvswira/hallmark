{
  "name": "@hallmark/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HallmarkRegistry: on-chain record of QoreChain contracts whose bytecode was matched against source.",
  "scripts": {
    "forge": "node scripts/forge.mjs",
    "forge-std": "git clone --depth 1 https://github.com/foundry-rs/forge-std lib/forge-std",
    "build": "node scripts/forge.mjs build",
    "test": "node scripts/forge.mjs test",
    "fmt": "node scripts/forge.mjs fmt",
    "window": "tsx --env-file=.env scripts/window.ts",
    "account": "tsx scripts/new-account.ts",
    "deploy:testnet": "node scripts/forge.mjs script script/DeployRegistry.s.sol --rpc-url qorechain_testnet --broadcast",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/sdk": "^0.14.0"
  },
  "devDependencies": {
    "@foundry-rs/forge": "^1.7.1",
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "viem": "^2.0.0"
  }
}
